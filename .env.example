APP_NAME="SmartPOS Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the primary datastore (see docker-compose.yml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartpos
DB_USERNAME=smartpos
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SPA / mobile clients authenticate with Sanctum bearer tokens.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8080
FRONTEND_URL=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Local mailer prints to terminal (stderr) instead of a log file — no SMTP needed for dev.
MAIL_LOG_CHANNEL=stderr
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@smartpos.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage for product images, receipts and backups.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backup disk: "local" for dev, "s3" for production
BACKUP_DISK=local
# Email for backup health monitor notifications
BACKUP_NOTIFY_EMAIL=admin@smartpos.test

VITE_APP_NAME="${APP_NAME}"

# PostHog telemetry (set the project key to enable; leave blank to disable)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
#POSTHOG_ENABLED=true

# --- Media / Cloudflare R2 ---------------------------------------------------
# Which disk uploaded images are written to. Leave as `public` for local work;
# set to `r2` in staging and production.
MEDIA_DISK=public

# R2_ENDPOINT is the private, credentialed API endpoint:
#   https://<account-id>.r2.cloudflarestorage.com
# R2_URL is the *public* read URL for the same bucket, and is what ends up in an
# <img src>. Use a custom domain bound to the bucket in production; the r2.dev
# subdomain is rate-limited and not meant for production traffic.
# Leaving R2_URL empty makes the bucket private and switches image URLs to
# time-limited signed links (see MEDIA_SIGNED_URL_TTL).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_DEFAULT_REGION=auto

MEDIA_SIGNED_URL_TTL=3600
